{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/data", "**/data/**", "**/ui", "**/ui/**"],
                "message": "Regla de capas: domain no puede importar de data ni de ui. domain solo contiene tipos y lógica pura; data y ui dependen de domain, nunca al revés."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ui", "**/ui/**"],
                "message": "Regla de capas: data no puede importar de ui. data implementa puertos que domain y ui consumen; ui depende de data, nunca al revés."
              }
            ]
          }
        ]
      }
    }
  ]
}
